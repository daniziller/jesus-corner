<!--
    Estrutura de duas camadas de verdade, no lugar da gerada pelo Bubblewrap
    (fundo branco + o ícone inteiro com 8.5dp de padding, frente vazia). A
    antiga deixava uma borda branca em volta do ícone depois do recorte do
    sistema e desabilitava o parallax, porque a camada de frente era
    transparente. Agora o fundo é a cor da marca e a frente é só a cruz.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_maskable" />
</adaptive-icon>
