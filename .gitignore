.vercel
node_modules
dist
.env
.env.local

# Assinatura do Android — nunca deve ir pro controle de versão
android-twa/*.keystore
android-twa/key.properties
android-twa/android-keystore-credentials.txt

# Build artifacts (Android/Gradle)
android-twa/.gradle
android-twa/build
android-twa/app/build
android-twa/local.properties

# Build artifacts (iOS/Xcode)
ios/App/Pods
ios/App/build
ios/App/DerivedData
ios/**/xcuserdata
ios/**/*.xcuserstate
ios/App/App.xcodeproj/project.xcworkspace/xcshareddata

# Binários compilados do Android (regeneráveis a partir do código-fonte)
android-twa/*.apk
android-twa/*.aab
android-twa/*.idsig

# Config/estado local do Claude Code (específico desta máquina)
.claude/
.env*

# Metadados do Finder (macOS) — criados em qualquer pasta aberta no Finder
.DS_Store

# Scripts/artefatos de teste manual (Playwright ao vivo, screenshots) —
# nunca devem ir pro repo, só existem durante verificação local.
.debug-*

# Estado local do CLI da Supabase (link do projeto) — específico desta
# máquina, regenerado a qualquer momento com `supabase link`.
supabase/.temp/
