{
  "crons": [
    {
      "path": "/api/send-contribution-reminders",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/retention",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/send-reading-reminders",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/send-weekly-digest",
      "schedule": "0 9 * * 1"
    }
  ],
  "functions": {
    "api/admin/broadcast.js": {
      "maxDuration": 60
    },
    "api/send-weekly-digest.js": {
      "maxDuration": 300
    },
    "api/retention.js": {
      "maxDuration": 60
    },
    "api/delete-account.js": {
      "maxDuration": 60
    },
    "api/generate-theme-plan.js": {
      "maxDuration": 240
    },
    "api/chat-about-text.js": {
      "maxDuration": 60
    },
    "api/tts.js": {
      "maxDuration": 60
    }
  }
}
