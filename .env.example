# Copie este arquivo pra ".env" e preencha com os valores do seu projeto
# Supabase (Project Settings → API no dashboard do Supabase).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui

# Service role key (Project Settings → API) — nunca prefixo VITE_*, nunca
# vai pro bundle do client. Usada por todo endpoint em api/ que precisa
# escrever/ler ignorando RLS (webhooks, verificação de compra, painel admin).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui

# Painel admin (server-side) — allowlist de e-mails com acesso à aba Admin
# do app, separados por vírgula.
ADMIN_EMAILS=daniela@jesuscorner.app

# Resend (https://resend.com) — envio de e-mail transacional (confirmação de
# cadastro/reset de senha, convite de amigo, respostas do painel admin).
# Já configuradas no Vercel (produção); preencha aqui só se for rodar esses
# fluxos localmente.
RESEND_API_KEY=
SEND_EMAIL_HOOK_SECRET=
INVITE_FROM_EMAIL="Jesus' Corner <convite@jesuscorner.app>"

# Vercel AI Gateway (https://vercel.com/docs/ai-gateway) — usado só por
# api/generate-theme-plan.js (plano de leitura por tema). Em produção na
# Vercel funciona sem essa chave via OIDC automático; preencha aqui só se
# for rodar esse endpoint localmente.
AI_GATEWAY_API_KEY=

# App Store (compras no app iOS) — ver api/_lib/apple.js. Chave .p8 de
# "In-App Purchase" em App Store Connect → Users and Access → Integrations.
APPLE_PRIVATE_KEY=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
# "Apple ID" numérico do app (App Store Connect → App Information). Obrigatório
# pra verificar compras de produção (a lib da Apple exige).
APPLE_APP_APPLE_ID=
# Certificado(s) raiz da Apple em DER → base64, separados por vírgula — baixe
# "Apple Root CA - G3" em https://www.apple.com/certificateauthority/ e rode
# `base64 -w0 AppleRootCA-G3.cer`. Alternativa: versionar o .cer em
# api/_lib/AppleRootCA-G3.cer (ou api/_lib/apple-roots/AppleRootCA-G3.cer).
APPLE_ROOT_CERTS_BASE64=

# Provedores OAuth ativados em Authentication → Providers no Supabase, separados
# por vírgula ("google,apple"). Vazio esconde os botões "Continuar com Google/
# Apple" da tela de entrar (quadro 13b) — eles só aparecem quando o provedor
# de fato funciona. No app iOS, oferecer Google exige oferecer Apple também.
VITE_OAUTH_PROVIDERS=
